# Messaging Express configuration. Copy to .env.local and fill in the required values.
# Full reference: docs/configuration.md
#
# Scripts such as `npm run db:migrate` do NOT read .env.local; pass it explicitly:
#   npx tsx --env-file=.env.local scripts/migrate.ts
# PORT, HOST, SHUTDOWN_TIMEOUT_MS and SOAK_STATS_INTERVAL_MS are read before Next loads env files:
# set them as real environment variables, not here.

# ---------------------------------------------------------------- Required
# Postgres connection string (Supabase, Neon, RDS, local, ...)
DATABASE_URL=postgresql://user:password@localhost:5432/messaging_express
# Signs and verifies every token. Long and random:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Lifetime of tokens minted by the server's own helper (default 7d)
# JWT_EXPIRATION=7d

# ---------------------------------------------------------------- Server
# Public base URL (used to build URLs of locally stored uploads)
APP_URL=http://localhost:3000
# debug | info | warn | error | silent
LOG_LEVEL=info
# Comma-separated exact origins, no spaces; * allows any origin. Applies to REST and Socket.IO.
CORS_ALLOWED_ORIGINS=*
# Largest JSON body in bytes (default 262144). Larger gets 413 PAYLOAD_TOO_LARGE.
# MAX_JSON_BODY_BYTES=262144
# Reuse a project lookup for N seconds (1-3600) to save a query per request. Default off.
# A project you deactivate keeps working on each instance for up to this long.
# PROJECT_CACHE_TTL_SECONDS=0

# ---------------------------------------------------------------- Realtime
# none (default) | socketio. Needs the custom server: npm run dev:socket, or npm start after npm run build.
# REALTIME_PROVIDER=socketio
# Needed when you run more than one instance, same value on all of them.
# REDIS_URL=redis://localhost:6379
# Log a server_stats line (memory, sockets, ...) every N ms. 0 = off. (Real environment variable.)
# SOAK_STATS_INTERVAL_MS=0

# ---------------------------------------------------------------- Access control
# off (default) | dry-run | enforce. See docs/access-control.md
# PARTICIPANT_ACCESS_MODE=off

# ---------------------------------------------------------------- Rate limiting
# off (default) | dry-run | enforce. See docs/rate-limiting.md
# RATE_LIMIT_MODE=off
# Override limits per route group, e.g. {"messages:POST":{"limit":60,"windowMs":60000}}
# RATE_LIMITS_JSON=

# ---------------------------------------------------------------- Webhooks
# off (default) | on. Exactly "on" enables it ("true" and "1" do not).
# WEBHOOK_DISPATCH=off
# Per-organization URL and secret are columns of mx_organizations. This is the fallback signing secret.
# WEBHOOK_SECRET=
# How long your endpoint has to answer, in ms
# WEBHOOK_TIMEOUT_MS=5000
# off (default) | on. Retries failed deliveries (1 min, 5 min, 30 min, 2 h; 5 attempts). Needs a scheduler that calls
#   POST /api/internal/webhooks/retry   with   Authorization: Bearer $CRON_SECRET   every minute.
# WEBHOOK_RETRY=off
# CRON_SECRET=
# WEBHOOK_RETRY_BATCH=25

# ---------------------------------------------------------------- Uploads
# local (default) | s3 | supabase | firebase | php. Set only the selected provider's variables.
STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_CONCURRENT_UPLOADS=4
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,application/pdf

# s3 (also Cloudflare R2, DigitalOcean Spaces, MinIO through S3_ENDPOINT)
# S3_BUCKET=
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# supabase (the bucket must be public)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=

# firebase (a private key with literal \n sequences is fine)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=<project>.appspot.com

# php (multipart POST: file, uniqueId, category, fileType; answers {success, url})
# PHP_UPLOAD_ENDPOINT=https://files.example.com/upload.php

# ---------------------------------------------------------------- End-to-end encryption
# off (default) | on. Read docs/e2ee/guide.md BEFORE turning it on or off.
# E2EE_ENABLED=off
# MAX_DEVICES_PER_USER=10        # 1-50
# PAIRING_TTL_SECONDS=60         # 30-300
# E2EE_KEYS_MAX_BATCH=200        # 1-1000
