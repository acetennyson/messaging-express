# Database (Supabase or any Postgres)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# JWT Authentication
JWT_SECRET=<openssl rand -base64 48>
JWT_EXPIRATION=7d

# API Configuration
APP_URL=http://localhost:3000
API_VERSION=v1

# Rate Limiting: see RATE_LIMIT_MODE further down (Stage 3, lib/rate-limit).
# Nothing in this codebase reads a RATE_LIMIT_DISABLED / _WINDOW_MS / _MAX_REQUESTS
# style var — don't set those, they won't do anything.

# Media upload: see STORAGE_PROVIDER / MAX_UPLOAD_SIZE_BYTES / UPLOAD_ALLOWED_MIME_TYPES
# further down (Stage 1, lib/storage). Nothing reads a MEDIA_* prefixed var here —
# don't set those, they won't do anything.

# AWS S3 (optional — used once STORAGE_PROVIDER=s3 ships in Stage 2; not read yet)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Email (for notifications and verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@messagingexpress.com

# Websocket (for real-time messaging): no separate port. Stage 5's design
# (REDESIGN.md §4) attaches Socket.IO to the same server.ts HTTP server
# this app already listens on — there's no WS_PORT/WS_ENABLED to set.
# See REDIS_URL further down for multi-instance fan-out once that ships.

# Logging
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=*

# Webhooks
WEBHOOK_SECRET=<openssl rand -hex 32>
WEBHOOK_TIMEOUT_MS=5000

# --- Uploads (Stage 1: read by lib/storage) ---
# Only `local` exists so far; an unrecognized value throws on upload.
# local stores files in public/uploads and returns APP_URL-based URLs.
STORAGE_PROVIDER=local
MAX_CONCURRENT_UPLOADS=4
MAX_UPLOAD_SIZE_BYTES=26214400
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,application/pdf

# --- Planned (see IMPLEMENTATION_PLAN.md). Nothing reads these yet. ---
# RATE_LIMIT_MODE=off
# REDIS_URL=
