# Database (Supabase or any Postgres)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# JWT Authentication
JWT_SECRET=<openssl rand -base64 48>
JWT_EXPIRATION=7d

# API Configuration
APP_URL=http://localhost:3000
API_VERSION=v1

# Rate Limiting
RATE_LIMIT_DISABLED=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Media Upload
MEDIA_UPLOAD_MAX_SIZE=10485760
MEDIA_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,application/pdf
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PATH=./uploads

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Email (for notifications and verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@messagingexpress.com

# Websocket (for real-time messaging)
WS_PORT=3001
WS_ENABLED=true

# Logging
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=*

# Webhooks
WEBHOOK_SECRET=<openssl rand -hex 32>
WEBHOOK_TIMEOUT_MS=5000

# --- Planned (see IMPLEMENTATION_PLAN.md). Nothing reads these yet. ---
# STORAGE_PROVIDER=local
# MAX_CONCURRENT_UPLOADS=4
# RATE_LIMIT_MODE=off
# REDIS_URL=
