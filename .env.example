# Database (Supabase or any Postgres)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# JWT Authentication
JWT_SECRET=<openssl rand -base64 48>
JWT_EXPIRATION=7d

# API Configuration
APP_URL=http://localhost:3000
API_VERSION=v1

# Rate Limiting: see RATE_LIMIT_MODE further down (Stage 3, lib/rate-limit).
# Nothing in this codebase reads a RATE_LIMIT_DISABLED / _WINDOW_MS / _MAX_REQUESTS
# style var — don't set those, they won't do anything.

# Media upload: see STORAGE_PROVIDER / MAX_UPLOAD_SIZE_BYTES / UPLOAD_ALLOWED_MIME_TYPES
# further down (Stage 1, lib/storage). Nothing reads a MEDIA_* prefixed var here —
# don't set those, they won't do anything.

# --- Storage providers (Stage 2). Set STORAGE_PROVIDER, then ONLY that provider's vars. ---
# STORAGE_PROVIDER=local | s3 | supabase | firebase | php   (default: local)
# Providers are loaded lazily: unselected ones are never imported or validated.
# For s3/supabase/firebase the client uploads straight to the bucket via
# POST /api/v1/uploads/presign; local/php answer 501 there and the client falls
# back to POST /api/v1/uploads. All bucket-style providers require the bucket
# (or its CDN) to be publicly readable, since message attachments store plain URLs.

# s3 (also R2 / DigitalOcean Spaces / MinIO via S3_ENDPOINT)
S3_BUCKET=
S3_REGION=us-east-1
# Credentials: set these, or leave unset to use the AWS SDK default chain (IAM role etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional:
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true          (defaults to true when S3_ENDPOINT is set)
# S3_PUBLIC_BASE_URL=https://cdn.example.com   (public URL prefix if different from the bucket URL)
# Legacy aliases still honored: AWS_REGION, AWS_S3_BUCKET

# supabase (server-only service role key; bucket must be public)
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=

# firebase (service account; private key with literal \n sequences is fine)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_STORAGE_BUCKET=<project>.appspot.com

# php (legacy self-hosted endpoint: multipart file/uniqueId/category/fileType -> {success,url})
# PHP_UPLOAD_ENDPOINT=https://files.example.com/upload.php

# Email (for notifications and verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@messagingexpress.com

# Websocket (for real-time messaging): no separate port. Stage 5's design
# (REDESIGN.md §4) attaches Socket.IO to the same server.ts HTTP server
# this app already listens on — there's no WS_PORT/WS_ENABLED to set.
# See REDIS_URL further down for multi-instance fan-out once that ships.

# Logging
LOG_LEVEL=info

# CORS
CORS_ALLOWED_ORIGINS=*

# Webhooks
WEBHOOK_SECRET=<openssl rand -hex 32>
WEBHOOK_TIMEOUT_MS=5000
# Webhook dispatch (Stage 4): off | on. Exactly "on" enables it; "true"/"1" are NOT accepted
# (treated as off, logged as invalid_flag_value). Read per request; set before the server starts.
# WEBHOOK_DISPATCH=off
# Webhook retries (Stage 4.4): off | on. When on, non-2xx responses and network errors are retried
# with backoff (1 min, 5 min, 30 min, 2 h), 5 attempts in total, driven by a cron that calls
#   POST /api/internal/webhooks/retry   with header   Authorization: Bearer $CRON_SECRET
# (every minute). With CRON_SECRET unset the route refuses every request.
# WEBHOOK_RETRY=off
# CRON_SECRET=<openssl rand -hex 32>
# WEBHOOK_RETRY_BATCH=25

# --- Uploads (Stage 1: read by lib/storage) ---
# Only `local` exists so far; an unrecognized value throws on upload.
# local stores files in public/uploads and returns APP_URL-based URLs.
STORAGE_PROVIDER=local
MAX_CONCURRENT_UPLOADS=4
MAX_UPLOAD_SIZE_BYTES=26214400
# UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,application/pdf

# --- Planned (see IMPLEMENTATION_PLAN.md). Nothing reads these yet. ---
# RATE_LIMIT_MODE=off
# REDIS_URL=
