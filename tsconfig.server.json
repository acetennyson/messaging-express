{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "jsx": "preserve",
    "plugins": [],
    "paths": {}
  },
  "include": ["server.ts"],
  "exclude": ["node_modules", "dist", ".next"]
}
