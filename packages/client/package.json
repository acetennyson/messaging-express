{
  "name": "@messaging-express/client",
  "version": "0.1.0",
  "description": "Client SDK for the Messaging Express API: typed requests, retries and parallel uploads (presign with automatic fallback).",
  "keywords": [
    "messaging",
    "chat",
    "uploads",
    "presigned-url",
    "sdk",
    "messaging-express"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./realtime": {
      "import": {
        "types": "./dist/realtime.d.ts",
        "default": "./dist/realtime.js"
      },
      "require": {
        "types": "./dist/realtime.d.cts",
        "default": "./dist/realtime.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "typesVersions": {
    "*": {
      "realtime": [
        "./dist/realtime.d.ts"
      ]
    }
  },
  "peerDependencies": {
    "socket.io-client": ">=4.4.0"
  },
  "peerDependenciesMeta": {
    "socket.io-client": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acetennyson/messaging-express.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/acetennyson/messaging-express/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/acetennyson/messaging-express/issues"
  }
}
