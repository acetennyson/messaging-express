{
  "name": "@messaging-express/client-crypto",
  "version": "0.1.0",
  "description": "End-to-end encryption for Messaging Express: device keys, per-conversation keys, encrypted messages and attachments. Add-on for @messaging-express/client.",
  "keywords": [
    "messaging",
    "e2ee",
    "end-to-end-encryption",
    "xchacha20-poly1305",
    "x25519",
    "messaging-express"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./stores/indexeddb": {
      "import": {
        "types": "./dist/stores/indexeddb.d.ts",
        "default": "./dist/stores/indexeddb.js"
      },
      "require": {
        "types": "./dist/stores/indexeddb.d.cts",
        "default": "./dist/stores/indexeddb.cjs"
      }
    },
    "./package.json": "./package.json",
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "stores/indexeddb": [
        "./dist/stores/indexeddb.d.ts"
      ],
      "testing": [
        "./dist/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:playground": "esbuild playground/main.ts --bundle --ignore-annotations --alias:@messaging-express/client=../client/src/index.ts --format=iife --target=es2020 --sourcemap --outfile=playground/dist/main.js",
    "playground": "npm run build:playground && node playground/serve.mjs",
    "crosscheck": "node scripts/crosscheck.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "peerDependencies": {
    "@messaging-express/client": ">=0.1.0"
  },
  "devDependencies": {
    "@messaging-express/client": "*",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acetennyson/messaging-express.git",
    "directory": "packages/client-crypto"
  },
  "homepage": "https://github.com/acetennyson/messaging-express/tree/main/packages/client-crypto#readme",
  "bugs": {
    "url": "https://github.com/acetennyson/messaging-express/issues"
  }
}
