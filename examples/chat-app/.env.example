# Copy to .env and fill in. Never commit .env.
# A Postgres you can write to. The chat tables go in their own schema ("messaging"), away from yours.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat_demo
# 32+ random characters. Anyone who knows it can mint chat tokens.
CHAT_JWT_SECRET=change-me-change-me-change-me-change-me
PORT=3000
